FROM golang:1.26.6-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gravityerd-schema ./cmd/gravityerd-schema

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/gravityerd-schema /usr/local/bin/gravityerd-schema
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/gravityerd-schema"]
